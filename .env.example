# PR Review Agent — environment configuration
# Copy this file to .env and fill in real values before running locally or via docker-compose.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# "github_models" (free dev tier) or "azure_openai" (production)
LLM_PROVIDER=github_models

# Azure OpenAI chat deployment name (used regardless of provider as the model/deployment id)
AZURE_CHAT_DEPLOYMENT=gpt-4o

# Required when LLM_PROVIDER=azure_openai
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# ── GitHub ───────────────────────────────────────────────────────────────────
# Local fallback only. Production should use GITHUB_AUTH_MODE=app instead.
GITHUB_AUTH_MODE=token
GITHUB_TOKEN=

# Production GitHub App authentication. The provider mints and refreshes installation tokens.
# GitHub's PKCS#1 and PKCS#8 RSA PEM formats are supported; escaped \n separators work.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY=

# Separate inference-only credential. Never reuse a repository write token for model access.
GITHUB_MODELS_TOKEN=

# Secret configured on the GitHub webhook — used to validate the X-Hub-Signature-256 header.
GITHUB_WEBHOOK_SECRET=

# Required, comma-separated default-deny allowlist of repositories the installation may review.
GITHUB_REPOSITORY_ALLOWLIST=mrinmoyece/pr-review-agent

# Override only if you need to point at a non-default GitHub Models endpoint.
GITHUB_MODELS_ENDPOINT=https://models.inference.ai.azure.com

# ── Jira integration (optional — leave blank to disable ticket alignment check) ──
# When configured, the agent verifies the PR diff implements the linked Jira ticket.
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_TOKEN=
JIRA_USER_EMAIL=

# ── Review history (optional) ────────────────────────────────────────────────
# Number of past closed PRs to scan for team coding patterns (default: 20).
# Higher values = richer context, more GitHub API calls.
REVIEW_HISTORY_PR_COUNT=20

# Enables reporting of low-risk fix candidates. The agent never writes repository content.
REVIEW_AUTO_FIX_ENABLED=false

# Bound model fan-out per specialist pass to control latency and spend.
REVIEW_LLM_MAX_CHUNKS_PER_PASS=20
REVIEW_LLM_VERIFICATION_BATCH_SIZE=20

# Optional authenticated manual trigger. The endpoint returns 404 when disabled.
REVIEW_MANUAL_TRIGGER_ENABLED=false
REVIEW_MANUAL_TRIGGER_TOKEN=

# Shared idempotency store required when running one or more replicas.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Required by Compose interpolation, including Redis-only startup.
GRAFANA_ADMIN_PASSWORD=change-me-for-local-development

# ── Build-time (optional) ────────────────────────────────────────────────────
# NVD API key to avoid rate-limiting during the OWASP dependency-check CVE feed sync.
NVD_API_KEY=
